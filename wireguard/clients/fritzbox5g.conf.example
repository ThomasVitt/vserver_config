# /etc/wireguard/wg0.conf auf dem Raspberry Pi (Home Assistant)
[Interface]
Address = 10.8.0.3/24
PrivateKey = <PRIVATE_KEY_DES_PI>

[Peer]
# vServer
PublicKey = <PUBLIC_KEY_DES_SERVERS>
Endpoint = vpn.tvitt.de:51820
AllowedIPs = 10.8.0.0/24
# haelt die Verbindung durch NAT/CGNAT der 5G-FritzBox offen
PersistentKeepalive = 25
