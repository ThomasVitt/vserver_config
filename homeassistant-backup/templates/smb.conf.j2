# {{ ansible_managed }}
[global]
   workgroup = WORKGROUP
   server string = vServer Backup
   server role = standalone server
   security = user
   map to guest = never
   # nur im VPN lauschen
   interfaces = lo {{ wg_interface }}
   bind interfaces only = yes
   hosts allow = 127.0.0.1 {{ backup_allowed_networks | join(' ') }}
   hosts deny = 0.0.0.0/0
   server min protocol = SMB2
   smb ports = 445
   disable netbios = yes
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file

[{{ backup_share }}]
   path = {{ backup_path }}
   valid users = {{ backup_user }}
   force user = {{ backup_user }}
   read only = no
   browseable = no
   create mask = 0600
   directory mask = 0700
